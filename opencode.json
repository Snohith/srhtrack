{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "snapshot": true,
  "subagent_depth": 5,
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "lsp", "resource": "*", "effect": "allow" },
    { "action": "doom_loop", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "pip install -r requirements.txt", "effect": "allow" },
    { "action": "shell", "resource": "pip install pytest", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "python -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": "python handy_tools/refresh_player_list.py", "effect": "allow" },
    { "action": "shell", "resource": "venv/bin/python *", "effect": "allow" },
    { "action": "shell", "resource": "streamlit run app.py", "effect": "allow" },
    { "action": "shell", "resource": "make install", "effect": "allow" },
    { "action": "shell", "resource": "make run", "effect": "allow" },
    { "action": "shell", "resource": "make test", "effect": "allow" },
    { "action": "shell", "resource": "make sync-squads", "effect": "allow" },
    { "action": "shell", "resource": "make clean", "effect": "allow" },
    { "action": "shell", "resource": "make help", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean -f*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "rm -r *", "effect": "ask" },
    { "action": "shell", "resource": "rm *.db", "effect": "ask" },
    { "action": "shell", "resource": "sqlite3 *", "effect": "ask" },
    { "action": "shell", "resource": "gh *", "effect": "ask" },
    { "action": "shell", "resource": "*deploy*", "effect": "ask" },
    { "action": "shell", "resource": "printenv *", "effect": "ask" },
    { "action": "shell", "resource": "env", "effect": "ask" },
    { "action": "shell", "resource": "cat .env*", "effect": "ask" },
    { "action": "shell", "resource": "git remote -v", "effect": "ask" },
    { "action": "shell", "resource": "git config *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf / *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~ *", "effect": "deny" }
  ]
