# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files - preserve byte-exact content without line-ending conversion
*.xlsx binary
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
