# Copy to .env and fill in the Telegram values. Never commit .env.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides. Use absolute paths for a cron deployment.
# SUNRISERS_DB_PATH=/absolute/path/to/sunrisers_news.db
# SUNRISERS_LOG_DIR=/absolute/path/to/logs
# SUNRISERS_ROSTER_PATH=/absolute/path/to/squadofsunrisers.xlsx
