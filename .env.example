# ==============================================================================
# Sunrisers news hub — your settings (copy to .env)
# Copy this file to .env and customize values for your deployment environment.
# ==============================================================================

# Database Path override (defaults to saved_stories/sunrisers_news.db if not specified)
# SRH_DB_PATH=/absolute/path/to/srh_tracker.db

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# How often to check the news (in seconds, default 900 = 15 minutes)
HOW_OFTEN_TO_CHECK_NEWS_SECS=900 

# ==============================================================================
# Phone texts (Telegram) — one message per fresh story we save.
# Setup: 1) chat with @BotFather on Telegram → /newbot → copy the token below.
#        2) chat with @userinfobot → copy your chat id below (for a channel,
#           add the bot as admin and use the channel id, e.g. -1001234567890).
#        3) cp .env.example .env and restart the app / worker.
# Leave the token/chat empty to run without texts (saving news is unaffected).
# ==============================================================================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# per_article (one message per story, overflow collapses to a digest)
# or digest (one summary message per news check)
TELEGRAM_MODE=per_article
# Max per-article messages per cycle (1-50) before overflow digest kicks in
TELEGRAM_MAX_ALERTS_PER_CYCLE=10
# Heartbeat DM on empty cycles ("sweep clean, no fresh stories") so a quiet
# cycle is distinguishable from a dead pipeline. NOTE: this sends ~96 DMs/day
# when news is slow — set to false anytime to silence it.
TELEGRAM_HEARTBEAT=true
